{
  "name": "hitd2",
  "version": "2.0.2",
  "description": "A Node.js wrapper for the Hitmo API (Unofficial) http://hitmo.me",
  "keywords": [
    "api",
    "hitmos",
    "hitmos.me",
    "music",
    "wrapper"
  ],
  "license": "MIT",
  "author": "Dirold2",
  "contributors": [
    "Dirold2 (https://github.com/dirold2)"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dirold2/spd2.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && esbuild 'dist/**/*.js' --outdir=dist --allow-overwrite --minify --sourcemap && d-build",
    "dist": "d-dist",
    "deploy": "npm run build && npm run dist",
    "publish": "d-publish",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "prepublish": "npm run build",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format": "oxlint --fix . && oxfmt .",
    "smoke:track": "dotenv -e .env -- tsx example/track.ts",
    "test:hosts": "node --import tsx tests/hosts.ts",
    "test:albums": "node --import tsx tests/albums.ts",
    "test:hitmonet": "node --import tsx tests/hitmonet.ts",
    "test:providers": "node --import tsx tests/providers.ts",
    "test:scoring": "node --import tsx tests/scoring.ts",
    "test:retry": "node --import tsx tests/retry.ts",
    "test:audio-urls": "node --import tsx tests/audio-urls.ts",
    "test:stream": "node --import tsx tests/stream.ts",
    "test": "npm run test:stream && npm run test:initialize && npm run test:search && npm run test:audio-probe && npm run test:albums && npm run test:hitmonet && npm run test:hosts && npm run test:providers && npm run test:scoring && npm run test:retry && npm run test:audio-urls",
    "smoke:test": "dotenv -e .env -- tsx example/test.ts",
    "smoke:summary": "tsx smoke-runner.ts",
    "smoke:audio": "tsx example/search-audio.ts",
    "test:initialize": "node --import tsx tests/initialize.ts",
    "test:search": "node --import tsx tests/search.ts",
    "test:audio-probe": "node --import tsx tests/audio-probe.ts"
  },
  "dependencies": {
    "hcacher": "^0.3.0",
    "hyperttp": "^0.7.4",
    "node-html-parser": "^9.0.6"
  },
  "devDependencies": {
    "@dirold2/dev-tools": "^1.1.3",
    "@types/node": "^26.6.6",
    "chalk": "^6.0.1",
    "dotenv-cli": "^11.1.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.91.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
